{
  "name": "ester",
  "version": "0.1.0",
  "private": true,
  "description": "ESTER - a 3D space survival game",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"cross-env ESTER_DEV=1 electron .\"",
    "build:exe": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.jonizs.ester",
    "productName": "ESTER",
    "directories": {
      "output": "dist-exe",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "ESTER.exe"
    }
  }
}
